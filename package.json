{
  "name": "zeuge",
  "version": "0.1.0",
  "description": "A verification and receipt layer for people who run AI coding agents: instruction-order and hook-matcher lints, a claim-shape probe, and a hash-chained ledger.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "zeuge": "bin/zeuge.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    ".claude-plugin",
    "hooks",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify:dist": "node scripts/verify-dist.js",
    "pretest": "npm run verify:dist",
    "test": "vitest run",
    "relay:pins": "node relay/check-pins.mjs",
    "dev": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
