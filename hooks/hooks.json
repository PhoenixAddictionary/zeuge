{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeuge.js\" claim hook --event Stop", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeuge.js\" ledger hook --event PostToolUse", "timeout": 10 }
        ]
      }
    ]
  }
}
